        <rdfs:label xml:lang="pt">Empenho</rdfs:label>
        <pertenceA rdf:resource="#InfoRemessaInstancia"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#LiquidacaoInstancia">
        <rdf:type rdf:resource="#Liquidacao"/>
        <rdfs:label xml:lang="pt">Liquidação</rdfs:label>
        <pertenceA rdf:resource="#InfoRemessaInstancia"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#PagamentoInstancia">
        <rdf:type rdf:resource="#Pagamento"/>
        <rdfs:label xml:lang="pt">Pagamento</rdfs:label>
        <pertenceA rdf:resource="#InfoRemessaInstancia"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#ComprovanteLiquidacaoInstancia">
        <rdf:type rdf:resource="#ComprovanteLiquidacao"/>
        <rdfs:label xml:lang="pt">Comprovante de Liquidação</rdfs:label>
        <pertenceA rdf:resource="#InfoRemessaInstancia"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#PagamentoFinanceiroInstancia">
        <rdf:type rdf:resource="#PagamentoFinanceiro"/>
        <rdfs:label xml:lang="pt">Pagamento Financeiro</rdfs:label>
        <pertenceA rdf:resource="#InfoRemessaInstancia"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#BalanceteDespesaInstancia">
        <rdf:type rdf:resource="#BalanceteDespesa"/>
        <rdfs:label xml:lang="pt">Balancete de Despesa</rdfs:label>
        <pertenceA rdf:resource="#InfoRemessaInstancia"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#ContaDisponibilidadeInstancia">
        <rdf:type rdf:resource="#ContaDisponibilidade"/>
        <rdfs:label xml:lang="pt">Conta Disponibilidade</rdfs:label>
        <pertenceA rdf:resource="#InfoRemessaInstancia"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#LoaReceitaInstancia">
        <rdf:type rdf:resource="#LoaReceita"/>
        <rdfs:label xml:lang="pt">LOA Receita</rdfs:label>
        <pertenceA rdf:resource="#InfoRemessaInstancia"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#BalanceteReceitaInstancia">
        <rdf:type rdf:resource="#BalanceteReceita"/>
        <rdfs:label xml:lang="pt">Balancete de Receita</rdfs:label>
        <pertenceA rdf:resource="#InfoRemessaInstancia"/>
    </owl:NamedIndividual>

    <!-- Hierarquia de contas de receita (LOR5, BR7) -->
    <owl:NamedIndividual rdf:about="#ContaReceitaOrcamentariaPaiInstancia">
        <rdf:type rdf:resource="#ContaReceitaOrcamentaria"/>
        <rdfs:label xml:lang="pt">Conta Receita Orçamentária (sintética/pai)</rdfs:label>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#ContaReceitaOrcamentariaFilhaInstancia">
        <rdf:type rdf:resource="#ContaReceitaOrcamentaria"/>
        <rdfs:label xml:lang="pt">Conta Receita Orçamentária (analítica/filha)</rdfs:label>
        <contaFilhaDe rdf:resource="#ContaReceitaOrcamentariaPaiInstancia"/>
    </owl:NamedIndividual>

    <!-- Conta DDR (BV43) -->
    <owl:NamedIndividual rdf:about="#ContaDDRInstancia">
        <rdf:type rdf:resource="#ContaDDR"/>
        <codigoContabil>82110000000000000</codigoContabil>
        <rdfs:label xml:lang="pt">8.2.1.1.x - DDR Comprometida (Empenho/Liquidação)</rdfs:label>
    </owl:NamedIndividual>

    <!-- Conta de Superávit/Déficit (BV37) -->
    <owl:NamedIndividual rdf:about="#ContaSuperavitDeficitInstancia">
        <rdf:type rdf:resource="#ContaContabil"/>
        <codigoContabil>23710000000000000</codigoContabil>
        <rdfs:label xml:lang="pt">2.3.7.1.x - Superávit ou Déficit do Exercício</rdfs:label>
    </owl:NamedIndividual>


    <!-- =================================================================== -->
    <!-- INDIVÍDUOS — Regras (Família Equilíbrio Contábil, complemento)      -->
    <!-- =================================================================== -->

    <owl:NamedIndividual rdf:about="#BV30">
        <rdf:type rdf:resource="#RegraConsistenciaCreditoMovimentoContabil"/>
        <codigoRegra>BV30</codigoRegra>
        <descricaoRegra>O MovimentoContaCredora das contas escrituráveis (escrituração "S") do arquivo Balancete de Verificação deve ser igual à somatória dos lançamentos a crédito (Identificador "C") da referida conta no arquivo Movimento Contábil. Complementar à BV29.</descricaoRegra>
        <comparaMovimentoCom rdf:resource="#BalanceteVerificacaoInstancia"/>
        <comparaMovimentoCom rdf:resource="#MovimentoContabilInstancia"/>
        <detectaInconsistencia rdf:resource="#InconsistenciaMovimentoCreditoInstancia"/>
        <relacionadaCom rdf:resource="#BV29"/>
        <relacionadaCom rdf:resource="#BV3"/>
    </owl:NamedIndividual>


    <!-- =================================================================== -->
    <!-- INDIVÍDUOS — Regras (Família Execução da Despesa)                   -->
    <!-- =================================================================== -->

    <owl:NamedIndividual rdf:about="#LIQ3">
        <rdf:type rdf:resource="#RegraLimiteAcumuladoEmpenho"/>
        <codigoRegra>LIQ3</codigoRegra>
        <descricaoRegra>Conforme o parágrafo 2º do artigo 63 da Lei 4.320/64, a liquidação da despesa terá por base a nota de empenho. O valor acumulado/líquido de cada Liquidação não pode ser maior que o valor acumulado do Empenho/líquido equivalente.</descricaoRegra>
        <naoPodeSuperarAcumuladoDe rdf:resource="#EmpenhoInstancia"/>
        <detectaInconsistencia rdf:resource="#InconsistenciaLimiteAcumuladoEmpenhoInstanciaLIQ3"/>
        <relacionadaCom rdf:resource="#PG3"/>
        <relacionadaCom rdf:resource="#CLQ4"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#PG3">
        <rdf:type rdf:resource="#RegraLimiteAcumuladoEmpenho"/>
        <codigoRegra>PG3</codigoRegra>
        <descricaoRegra>Conforme o artigo 62 da Lei 4.320/64, o pagamento da despesa só será efetuado quando ordenado após sua regular liquidação. O valor acumulado/líquido de cada Pagamento não pode ser maior que o valor acumulado da Liquidação/líquida do Empenho equivalente.</descricaoRegra>
        <naoPodeSuperarAcumuladoDe rdf:resource="#EmpenhoInstancia"/>
        <detectaInconsistencia rdf:resource="#InconsistenciaLimiteAcumuladoEmpenhoInstanciaPG3"/>
        <relacionadaCom rdf:resource="#LIQ3"/>
        <relacionadaCom rdf:resource="#PGF3"/>
        <relacionadaCom rdf:resource="#BV43"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#LIQ4">
        <rdf:type rdf:resource="#RegraConsistenciaComBalancete"/>
        <codigoRegra>LIQ4</codigoRegra>
        <descricaoRegra>O valor liquidado deve ser igual em todos os arquivos. O valor acumulado do arquivo Liquidação deve ser igual ao valor acumulado do arquivo BalanceteDespesa no campo valorLiquidado.</descricaoRegra>
        <deveIgualarTotalDe rdf:resource="#BalanceteDespesaInstancia"/>
        <detectaInconsistencia rdf:resource="#InconsistenciaTotalDivergenteBalanceteInstanciaLIQ4"/>
        <relacionadaCom rdf:resource="#PG4"/>
        <relacionadaCom rdf:resource="#EMP8"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#PG4">
        <rdf:type rdf:resource="#RegraConsistenciaComBalancete"/>
        <codigoRegra>PG4</codigoRegra>
        <descricaoRegra>O valor pago deve ser igual em todos os arquivos. O valor acumulado do arquivo Pagamento deve ser igual ao valor acumulado do arquivo BalanceteDespesa no campo valorPago.</descricaoRegra>
        <deveIgualarTotalDe rdf:resource="#BalanceteDespesaInstancia"/>
        <detectaInconsistencia rdf:resource="#InconsistenciaTotalDivergenteBalanceteInstanciaPG4"/>
        <relacionadaCom rdf:resource="#LIQ4"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#EMP8">
        <rdf:type rdf:resource="#RegraConsistenciaComBalancete"/>
        <codigoRegra>EMP8</codigoRegra>
        <descricaoRegra>O valor empenhado deve ser igual em todos os arquivos. O valor acumulado do arquivo Empenho deve ser igual ao valor acumulado do arquivo BalanceteDespesa no campo valorEmpenhado.</descricaoRegra>
        <deveIgualarTotalDe rdf:resource="#BalanceteDespesaInstancia"/>
        <detectaInconsistencia rdf:resource="#InconsistenciaTotalDivergenteBalanceteInstanciaEMP8"/>
        <relacionadaCom rdf:resource="#LIQ4"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#CLQ4">
        <rdf:type rdf:resource="#RegraExistenciaCorrespondente"/>
        <codigoRegra>CLQ4</codigoRegra>
        <descricaoRegra>As Liquidações apresentadas no arquivo Liquidacao.xml devem constar também no arquivo ComprovanteLiquidacao.xml.</descricaoRegra>
        <deveExistirEm rdf:resource="#ComprovanteLiquidacaoInstancia"/>
        <detectaInconsistencia rdf:resource="#InconsistenciaExistenciaCorrespondenteInstanciaCLQ4"/>
        <relacionadaCom rdf:resource="#LIQ3"/>
        <relacionadaCom rdf:resource="#CLQ2"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#PGF3">
        <rdf:type rdf:resource="#RegraConsistenciaFonteRecurso"/>
        <codigoRegra>PGF3</codigoRegra>
        <descricaoRegra>A Fonte de recurso do Empenho deve ser igual em todos os arquivos. A Fonte (os quatro primeiros dígitos do idRecursoVinculado com o numeroEmpenho) informada no arquivo PagamentoFinanceiro deve coincidir com a Fonte relativa informada no arquivo Empenho.</descricaoRegra>
        <deveCoincidirFonteCom rdf:resource="#EmpenhoInstancia"/>
        <detectaInconsistencia rdf:resource="#InconsistenciaFonteDivergenteInstancia"/>
        <relacionadaCom rdf:resource="#PG3"/>
    </owl:NamedIndividual>


    <!-- =================================================================== -->
    <!-- INDIVÍDUOS — Regras (Família Disponibilidade Financeira)            -->
    <!-- =================================================================== -->

    <owl:NamedIndividual rdf:about="#CD7">
        <rdf:type rdf:resource="#RegraSaldoDerivadoBalancete"/>
        <codigoRegra>CD7</codigoRegra>
        <descricaoRegra>O somatório do Saldo Inicial do arquivo Conta Disponibilidade deve ser igual ao valor do SaldoAnteriorContaDevedora - SaldoAnteriorContaCredora da conta contábil equivalente no arquivo Balancete de Verificação.</descricaoRegra>
        <derivaSaldoDe rdf:resource="#BalanceteVerificacaoInstancia"/>
        <detectaInconsistencia rdf:resource="#InconsistenciaSaldoDerivadoBalanceteInstanciaCD7"/>
        <relacionadaCom rdf:resource="#CD8"/>
        <relacionadaCom rdf:resource="#CD9"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#CD8">
        <rdf:type rdf:resource="#RegraSaldoDerivadoBalancete"/>
        <codigoRegra>CD8</codigoRegra>
        <descricaoRegra>O somatório do Saldo Final do arquivo Conta Disponibilidade deve ser igual ao valor do SaldoAtualContaDevedora - SaldoAtualContaCredora da conta contábil equivalente no arquivo Balancete de Verificação.</descricaoRegra>
        <derivaSaldoDe rdf:resource="#BalanceteVerificacaoInstancia"/>
        <detectaInconsistencia rdf:resource="#InconsistenciaSaldoDerivadoBalanceteInstanciaCD8"/>
        <relacionadaCom rdf:resource="#CD7"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#CD9">
        <rdf:type rdf:resource="#RegraExistenciaCorrespondente"/>
        <codigoRegra>CD9</codigoRegra>
        <descricaoRegra>Todas as contas de caixa e equivalentes de caixa escrituráveis do arquivo Balancete de Verificação devem existir no arquivo Conta Disponibilidade.</descricaoRegra>
        <deveExistirEm rdf:resource="#ContaDisponibilidadeInstancia"/>
        <detectaInconsistencia rdf:resource="#InconsistenciaExistenciaCorrespondenteInstanciaCD9"/>
        <relacionadaCom rdf:resource="#CD7"/>
    </owl:NamedIndividual>


    <!-- =================================================================== -->
    <!-- INDIVÍDUOS — Regras (Família Receita/Orçamento)                     -->
    <!-- =================================================================== -->

    <owl:NamedIndividual rdf:about="#LOR5">
        <rdf:type rdf:resource="#RegraAgregacaoHierarquica"/>
        <codigoRegra>LOR5</codigoRegra>
        <descricaoRegra>O valor acumulado da conta Receita Orçamentária cadastrada como sintética deve corresponder ao somatório de suas contas correlatas (com os valores correspondentes se analítica ou sintética).</descricaoRegra>
        <agregaValoresDe rdf:resource="#ContaReceitaOrcamentariaPaiInstancia"/>
        <detectaInconsistencia rdf:resource="#InconsistenciaHierarquiaContasInstanciaLOR5"/>
        <relacionadaCom rdf:resource="#BR7"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#BR7">
        <rdf:type rdf:resource="#RegraAgregacaoHierarquica"/>
        <codigoRegra>BR7</codigoRegra>
        <descricaoRegra>As contas orçamentárias cadastradas do tipo sintética devem possuir valor igual ao somatório de suas contas filhas, no arquivo Balancete de Receita.</descricaoRegra>
        <agregaValoresDe rdf:resource="#ContaReceitaOrcamentariaPaiInstancia"/>
        <detectaInconsistencia rdf:resource="#InconsistenciaHierarquiaContasInstanciaBR7"/>
        <relacionadaCom rdf:resource="#LOR5"/>
        <relacionadaCom rdf:resource="#BR10"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#BR10">
        <rdf:type rdf:resource="#RegraProporcaoPercentual"/>
        <codigoRegra>BR10</codigoRegra>
        <descricaoRegra>A dedução da receita para formação do FUNDEB deve ser 20% da respectiva receita, na coluna valor Receita Realizada Acumulada.</descricaoRegra>
        <deveCorresponderPercentualDe rdf:resource="#BalanceteReceitaInstancia"/>
        <detectaInconsistencia rdf:resource="#InconsistenciaProporcaoPercentualInstancia"/>
        <relacionadaCom rdf:resource="#BR7"/>
    </owl:NamedIndividual>


    <!-- =================================================================== -->
    <!-- INDIVÍDUOS — Regras (padrões novos: transferência, orçamento, DDR)  -->
    <!-- =================================================================== -->

    <owl:NamedIndividual rdf:about="#BV37">
        <rdf:type rdf:resource="#RegraTransferenciaEntreExercicios"/>
        <codigoRegra>BV37</codigoRegra>
        <descricaoRegra>O Superávit ou Déficit do Exercício deve ser transferido para a conta Superávit ou Déficit de Exercícios Anteriores em 1º de janeiro. Assim, na 1ª a 6ª remessa, o SaldoAtualContaCredora e o SaldoAtualContaDevedora das contas de Superávit/Déficit do Exercício devem ser iguais a 0 (zero).</descricaoRegra>
        <verificaConta rdf:resource="#ContaSuperavitDeficitInstancia"/>
        <detectaInconsistencia rdf:resource="#InconsistenciaTransferenciaExercicioInstancia"/>
        <relacionadaCom rdf:resource="#BV3"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#BD6">
        <rdf:type rdf:resource="#RegraConsistenciaAlteracaoOrcamentariaDespesa"/>
        <codigoRegra>BD6</codigoRegra>
        <descricaoRegra>O somatório da coluna CreditoSuplementarExcessoArrecadacao do arquivo Balancete da Despesa deve ser igual ao somatório da coluna ValorAlteracao com TipoAlteracao 2 (Suplementação - Excesso de Arrecadação) do arquivo AlteracaoOrcamentaria.</descricaoRegra>
        <comparaCom rdf:resource="#AlteracaoOrcamentariaInstancia"/>
        <detectaInconsistencia rdf:resource="#InconsistenciaAlteracaoOrcamentariaDespesaInstanciaBD6"/>
        <relacionadaCom rdf:resource="#BD22"/>
        <relacionadaCom rdf:resource="#BV32"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#BD22">
        <rdf:type rdf:resource="#RegraConsistenciaAlteracaoOrcamentariaDespesa"/>
        <codigoRegra>BD22</codigoRegra>
        <descricaoRegra>O valor da Dotação Atualizada deve corresponder à dotação inicial acrescida dos créditos adicionais e deduzidas as reduções. Dotação Atualizada = dotação inicial + (atualização monetária + crédito suplementar + crédito especial + crédito extraordinário) - redução de dotação.</descricaoRegra>
        <comparaCom rdf:resource="#AlteracaoOrcamentariaInstancia"/>
        <detectaInconsistencia rdf:resource="#InconsistenciaAlteracaoOrcamentariaDespesaInstanciaBD22"/>
        <relacionadaCom rdf:resource="#BD6"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#BV43">
        <rdf:type rdf:resource="#RegraCoberturaDDR"/>
        <codigoRegra>BV43</codigoRegra>
        <descricaoRegra>Considerando que todas as despesas orçamentárias devem ser empenhadas, o somatório das contas de DDR Comprometida por Empenho, por Liquidação, por Consignações e Retenções e DDR Utilizada deve ser maior ou igual ao somatório dos Empenhos na fonte específica do arquivo Empenho.</descricaoRegra>
        <deveSerCobertoPor rdf:resource="#EmpenhoInstancia"/>
        <detectaInconsistencia rdf:resource="#InconsistenciaCoberturaDDRInstancia"/>
        <relacionadaCom rdf:resource="#PG3"/>
    </owl:NamedIndividual>

    <owl:NamedIndividual rdf:about="#CLQ2">
        <rdf:type rdf:resource="#RegraDeteccaoDuplicidade"/>
        <codigoRegra>CLQ2</codigoRegra>
        <descricaoRegra>Não é possível ter nota fiscal do mesmo credor, com o mesmo número, e com datas diferentes.</descricaoRegra>
        <detectaDuplicidadeEm rdf:resource="#ComprovanteLiquidacaoInstancia"/>
        <detectaInconsistencia rdf:resource="#InconsistenciaDuplicidadeDocumentoInstancia"/>
        <relacionadaCom rdf:resource="#CLQ4"/>
    </owl:NamedIndividual>


