<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.unitins.br/ontologias/sicap-contabil#"
     xml:base="http://www.unitins.br/ontologias/sicap-contabil"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:dc="http://purl.org/dc/elements/1.1/">

    <!-- =================================================================== -->
    <!-- Ontologia: SICAP Contábil - Regras de Validação                     -->
    <!-- Autora: Gisele de Oliveira Veloso                                   -->
    <!-- Instituição: UNITINS                                                -->
    <!-- Versão: 1.1                                                         -->
    <!-- =================================================================== -->

    <owl:Ontology rdf:about="http://www.unitins.br/ontologias/sicap-contabil">
        <dc:title>Ontologia de Regras de Validação do SICAP Contábil</dc:title>
        <dc:creator>Gisele de Oliveira Veloso</dc:creator>
        <dc:description>Ontologia que representa formalmente as regras de validação contábil do SICAP (Sistema Integrado de Controle e Auditoria Pública) do TCE/TO, com foco nas regras BV3, BV29 e BV32.</dc:description>
        <owl:versionInfo>1.1</owl:versionInfo>
    </owl:Ontology>


    <!-- =================================================================== -->
    <!-- PROPRIEDADES DE OBJETO (sem domain genérico — específicas por regra)-->
    <!-- =================================================================== -->

    <owl:ObjectProperty rdf:about="#detectaInconsistencia">
        <rdfs:label xml:lang="pt">detecta inconsistência</rdfs:label>
        <rdfs:comment>Relaciona uma regra ao tipo de inconsistência que ela detecta.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#verificaSaldoDe">
        <rdfs:label xml:lang="pt">verifica saldo de</rdfs:label>
        <rdfs:comment>BV3: verifica valores de movimento no Balancete de Verificação.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#comparaMovimentoCom">
        <rdfs:label xml:lang="pt">compara movimento com</rdfs:label>
        <rdfs:comment>BV29: compara o Balancete de Verificação com o Movimento Contábil.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#comparaCom">
        <rdfs:label xml:lang="pt">compara com</rdfs:label>
        <rdfs:comment>BV32: compara saldo da conta de Excesso de Arrecadação com as Alterações Orçamentárias.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#verificaConta">
        <rdfs:label xml:lang="pt">verifica conta</rdfs:label>
        <rdfs:comment>BV32: identifica a conta contábil específica verificada pela regra.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#pertenceA">
        <rdfs:label xml:lang="pt">pertence a</rdfs:label>
        <rdfs:comment>Arquivo contábil pertence a uma remessa (exercício e bimestre).</rdfs:comment>
        <rdfs:range rdf:resource="#InfoRemessa"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#relacionadaCom">
        <rdfs:label xml:lang="pt">relacionada com</rdfs:label>
        <rdfs:comment>BV3 e BV29 são relacionadas: falha na BV29 pode propagar desequilíbrio que viola BV3.</rdfs:comment>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#SymmetricProperty"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#implicaViolacaoDe">
        <rdfs:label xml:lang="pt">implica violação de</rdfs:label>
        <rdfs:comment>Uma inconsistência pode implicar a violação de outra regra.</rdfs:comment>
        <rdfs:range rdf:resource="#RegraContabil"/>
    </owl:ObjectProperty>



    <!-- == Família Execução da Despesa == -->

    <owl:ObjectProperty rdf:about="#naoPodeSuperarAcumuladoDe">
        <rdfs:label xml:lang="pt">não pode superar acumulado de</rdfs:label>
        <rdfs:comment>LIQ3 e PG3: o valor acumulado de Liquidação/Pagamento não pode superar o valor acumulado do Empenho equivalente.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#deveIgualarTotalDe">
        <rdfs:label xml:lang="pt">deve igualar total de</rdfs:label>
        <rdfs:comment>LIQ4, PG4 e EMP8: o total do arquivo deve ser igual ao total informado no BalanceteDespesa.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#deveExistirEm">
        <rdfs:label xml:lang="pt">deve existir em</rdfs:label>
        <rdfs:comment>CLQ4 e CD9: um registro de um arquivo deve ter correspondência obrigatória em outro arquivo.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#deveCoincidirFonteCom">
        <rdfs:label xml:lang="pt">deve coincidir fonte com</rdfs:label>
        <rdfs:comment>PGF3: a Fonte do PagamentoFinanceiro deve coincidir com a Fonte informada no Empenho equivalente.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#derivaSaldoDe">
        <rdfs:label xml:lang="pt">deriva saldo de</rdfs:label>
        <rdfs:comment>CD7 e CD8: o saldo (inicial ou final) da ContaDisponibilidade deriva do saldo líquido (devedor-credor) do Balancete de Verificação.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#agregaValoresDe">
        <rdfs:label xml:lang="pt">agrega valores de</rdfs:label>
        <rdfs:comment>LOR5 e BR7: o valor de uma conta sintética deve corresponder ao somatório de suas contas filhas (analíticas).</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#contaFilhaDe">
        <rdfs:label xml:lang="pt">conta filha de</rdfs:label>
        <rdfs:comment>Relação hierárquica entre uma conta orçamentária analítica (filha) e sua conta sintética (pai).</rdfs:comment>
        <rdfs:domain rdf:resource="#ContaReceitaOrcamentaria"/>
        <rdfs:range rdf:resource="#ContaReceitaOrcamentaria"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#deveCorresponderPercentualDe">
        <rdfs:label xml:lang="pt">deve corresponder a percentual de</rdfs:label>
        <rdfs:comment>BR10: a dedução para o FUNDEB deve corresponder a 20% do valor da Receita Realizada Acumulada.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#deveZerarNoInicioDoExercicio">
        <rdfs:label xml:lang="pt">deve zerar no início do exercício</rdfs:label>
        <rdfs:comment>BV37: o saldo de Superávit/Déficit do Exercício deve ser transferido (zerado) na 1ª remessa do exercício seguinte.</rdfs:comment>
        <rdfs:domain rdf:resource="#ContaContabil"/>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#deveSerCobertoPor">
        <rdfs:label xml:lang="pt">deve ser coberto por</rdfs:label>
        <rdfs:comment>BV43: o somatório das contas de DDR (Disponibilidade De Recursos) comprometida deve ser maior ou igual ao somatório dos Empenhos na fonte específica.</rdfs:comment>
    </owl:ObjectProperty>

    <owl:ObjectProperty rdf:about="#detectaDuplicidadeEm">
        <rdfs:label xml:lang="pt">detecta duplicidade em</rdfs:label>
        <rdfs:comment>CLQ2: identifica documentos (notas fiscais) com mesmo número e mesmo credor, porém com datas divergentes.</rdfs:comment>
        <rdfs:range rdf:resource="#ComprovanteLiquidacao"/>
    </owl:ObjectProperty>


    <!-- =================================================================== -->
    <!-- PROPRIEDADES DE DADOS                                               -->
    <!-- =================================================================== -->

    <owl:DatatypeProperty rdf:about="#codigoRegra">
        <rdfs:label xml:lang="pt">código da regra</rdfs:label>
        <rdfs:domain rdf:resource="#RegraContabil"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#descricaoRegra">
        <rdfs:label xml:lang="pt">descrição da regra</rdfs:label>
        <rdfs:domain rdf:resource="#RegraContabil"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#escrituracao">
        <rdfs:label xml:lang="pt">escrituração</rdfs:label>
        <rdfs:comment>S = escriturável, N = não escriturável.</rdfs:comment>
        <rdfs:domain rdf:resource="#BalanceteVerificacao"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#tipoBalancete">
        <rdfs:label xml:lang="pt">tipo do balancete</rdfs:label>
        <rdfs:comment>1 = Movimento do Exercício, 2 = Encerramento do Exercício.</rdfs:comment>
        <rdfs:domain rdf:resource="#BalanceteVerificacao"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#identificadorLancamento">
        <rdfs:label xml:lang="pt">identificador do lançamento</rdfs:label>
        <rdfs:comment>D = débito, C = crédito.</rdfs:comment>
        <rdfs:domain rdf:resource="#MovimentoContabil"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#tipoAlteracao">
        <rdfs:label xml:lang="pt">tipo de alteração</rdfs:label>
        <rdfs:comment>BV32 considera tipos 2, 6, 11 e 17.</rdfs:comment>
        <rdfs:domain rdf:resource="#AlteracaoOrcamentaria"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#codigoContabil">
        <rdfs:label xml:lang="pt">código contábil</rdfs:label>
        <rdfs:domain rdf:resource="#ContaContabil"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#exercicio">
        <rdfs:label xml:lang="pt">exercício</rdfs:label>
        <rdfs:domain rdf:resource="#InfoRemessa"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#bimestre">
        <rdfs:label xml:lang="pt">bimestre</rdfs:label>
        <rdfs:domain rdf:resource="#InfoRemessa"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#movimentoContaDevedora">
        <rdfs:label xml:lang="pt">movimento conta devedora</rdfs:label>
        <rdfs:domain rdf:resource="#BalanceteVerificacao"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#movimentoContaCredora">
        <rdfs:label xml:lang="pt">movimento conta credora</rdfs:label>
        <rdfs:domain rdf:resource="#BalanceteVerificacao"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#saldoAtualContaDevedora">
        <rdfs:label xml:lang="pt">saldo atual conta devedora</rdfs:label>
        <rdfs:domain rdf:resource="#BalanceteVerificacao"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#saldoAnteriorContaDevedora">
        <rdfs:label xml:lang="pt">saldo anterior conta devedora</rdfs:label>
        <rdfs:domain rdf:resource="#BalanceteVerificacao"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>



    <owl:DatatypeProperty rdf:about="#valorAcumulado">
        <rdfs:label xml:lang="pt">valor acumulado</rdfs:label>
        <rdfs:comment>Usada por Empenho, Liquidação e Pagamento (reaproveitada pelas 3 classes - LIQ3/PG3).</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#valorTotal">
        <rdfs:label xml:lang="pt">valor total do arquivo</rdfs:label>
        <rdfs:comment>Usada por Liquidação, Pagamento, Empenho e BalanceteDespesa (LIQ4/PG4/EMP8).</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#fonteRecurso">
        <rdfs:label xml:lang="pt">fonte de recurso</rdfs:label>
        <rdfs:comment>PGF3: os 4 primeiros dígitos do idRecursoVinculado. Usada por Empenho e PagamentoFinanceiro.</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>

    <owl:DatatypeProperty rdf:about="#percentualEsperado">
        <rdfs:label xml:lang="pt">percentual esperado</rdfs:label>
        <rdfs:comment>BR10: percentual fixo (ex.: 20% para FUNDEB) que um valor deve representar em relação a outro.</rdfs:comment>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>


    <!-- =================================================================== -->
    <!-- CLASSES DO DOMÍNIO                                                  -->
    <!-- =================================================================== -->

    <owl:Class rdf:about="#RegraContabil">
        <rdfs:label xml:lang="pt">Regra Contábil</rdfs:label>
        <rdfs:comment>Superclasse abstrata de todas as regras de validação do SICAP.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#Inconsistencia">
        <rdfs:label xml:lang="pt">Inconsistência</rdfs:label>
        <rdfs:comment>Superclasse de inconsistências detectadas pelas regras do SICAP.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#InfoRemessa">
        <rdfs:label xml:lang="pt">Informação de Remessa</rdfs:label>
        <rdfs:comment>Metadados da remessa: exercício, bimestre e unidade gestora.</rdfs:comment>
    </owl:Class>

    <owl:Class rdf:about="#ContaContabil">
        <rdfs:label xml:lang="pt">Conta Contábil</rdfs:label>
        <rdfs:comment>Conta do Plano de Contas Único, identificada por código de 17 dígitos.</rdfs:comment>
    </owl:Class>

    <!-- BalanceteVerificacao pertence a InfoRemessa -->
    <owl:Class rdf:about="#BalanceteVerificacao">
        <rdfs:label xml:lang="pt">Balancete de Verificação</rdfs:label>
        <rdfs:comment>Arquivo contábil com saldos e movimentos por conta contábil.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#pertenceA"/>
                <owl:someValuesFrom rdf:resource="#InfoRemessa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- MovimentoContabil pertence a InfoRemessa -->
    <owl:Class rdf:about="#MovimentoContabil">
        <rdfs:label xml:lang="pt">Movimento Contábil</rdfs:label>
        <rdfs:comment>Lançamentos contábeis individuais: D (débito) ou C (crédito).</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#pertenceA"/>
                <owl:someValuesFrom rdf:resource="#InfoRemessa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- AlteracaoOrcamentaria pertence a InfoRemessa -->
    <owl:Class rdf:about="#AlteracaoOrcamentaria">
        <rdfs:label xml:lang="pt">Alteração Orçamentária</rdfs:label>
        <rdfs:comment>Decretos de alteração orçamentária classificados por tipo.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#pertenceA"/>
                <owl:someValuesFrom rdf:resource="#InfoRemessa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>


    <!-- == Família Execução da Despesa: Empenho -> Liquidação -> Pagamento == -->

    <owl:Class rdf:about="#Empenho">
        <rdfs:label xml:lang="pt">Empenho</rdfs:label>
        <rdfs:comment>1º estágio da despesa pública (Lei 4.320/1964): reserva de dotação orçamentária para pagamento futuro.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#pertenceA"/>
                <owl:someValuesFrom rdf:resource="#InfoRemessa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#Liquidacao">
        <rdfs:label xml:lang="pt">Liquidação</rdfs:label>
        <rdfs:comment>2º estágio da despesa pública: verificação do direito adquirido pelo credor com base no Empenho.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#pertenceA"/>
                <owl:someValuesFrom rdf:resource="#InfoRemessa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#Pagamento">
        <rdfs:label xml:lang="pt">Pagamento</rdfs:label>
        <rdfs:comment>3º estágio da despesa pública: entrega efetiva de recursos ao credor, com base na Liquidação.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#pertenceA"/>
                <owl:someValuesFrom rdf:resource="#InfoRemessa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#ComprovanteLiquidacao">
        <rdfs:label xml:lang="pt">Comprovante de Liquidação</rdfs:label>
        <rdfs:comment>Documento (ex.: nota fiscal) que comprova/justifica uma Liquidação registrada.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#pertenceA"/>
                <owl:someValuesFrom rdf:resource="#InfoRemessa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#PagamentoFinanceiro">
        <rdfs:label xml:lang="pt">Pagamento Financeiro</rdfs:label>
        <rdfs:comment>Registro financeiro (extraorçamentário) do pagamento, com sua respectiva Fonte de recurso.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#pertenceA"/>
                <owl:someValuesFrom rdf:resource="#InfoRemessa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#BalanceteDespesa">
        <rdfs:label xml:lang="pt">Balancete de Despesa</rdfs:label>
        <rdfs:comment>Arquivo contábil com os totais de despesa por elemento (LIQ4, PG4, EMP8, BD6, BD22).</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#pertenceA"/>
                <owl:someValuesFrom rdf:resource="#InfoRemessa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>


    <!-- == Família Disponibilidade Financeira == -->

    <owl:Class rdf:about="#ContaDisponibilidade">
        <rdfs:label xml:lang="pt">Conta Disponibilidade</rdfs:label>
        <rdfs:comment>Arquivo com saldos de caixa e equivalentes de caixa por conta e fonte de recurso (CD7, CD8, CD9).</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#pertenceA"/>
                <owl:someValuesFrom rdf:resource="#InfoRemessa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>


    <!-- == Família Receita/Orçamento == -->

    <owl:Class rdf:about="#LoaReceita">
        <rdfs:label xml:lang="pt">LOA Receita</rdfs:label>
        <rdfs:comment>Lei Orçamentária Anual - previsão de receitas por conta (LOR5).</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#pertenceA"/>
                <owl:someValuesFrom rdf:resource="#InfoRemessa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#BalanceteReceita">
        <rdfs:label xml:lang="pt">Balancete de Receita</rdfs:label>
        <rdfs:comment>Arquivo contábil com os valores de receita realizada por conta (BR7, BR10).</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#pertenceA"/>
                <owl:someValuesFrom rdf:resource="#InfoRemessa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- ContaReceitaOrcamentaria: subclasse de ContaContabil, com hierarquia própria -->
    <owl:Class rdf:about="#ContaReceitaOrcamentaria">
        <rdfs:subClassOf rdf:resource="#ContaContabil"/>
        <rdfs:label xml:lang="pt">Conta Receita Orçamentária</rdfs:label>
        <rdfs:comment>Conta de receita, podendo ser sintética (agrega) ou analítica (filha) - base de LOR5 e BR7.</rdfs:comment>
    </owl:Class>

    <!-- ContaDDR: subclasse de ContaContabil (grupo 8.2.1.1.x - Disponibilidade De Recursos) -->
    <owl:Class rdf:about="#ContaDDR">
        <rdfs:subClassOf rdf:resource="#ContaContabil"/>
        <rdfs:label xml:lang="pt">Conta DDR (Disponibilidade De Recursos)</rdfs:label>
        <rdfs:comment>Grupo de contas 8.2.1.1.x que registram o comprometimento de recursos por empenho/liquidação (base de BV43).</rdfs:comment>
    </owl:Class>


    <!-- =================================================================== -->
    <!-- SUBCLASSES DE RegraContabil — restrições específicas por regra      -->
    <!-- =================================================================== -->

    <!-- BV3 -->
    <owl:Class rdf:about="#RegraEquilibrioMovimento">
        <rdfs:subClassOf rdf:resource="#RegraContabil"/>
        <rdfs:label xml:lang="pt">Regra BV3 - Equilíbrio do Movimento</rdfs:label>
        <rdfs:comment>BV3: Σ movimentoDevedora = Σ movimentoCredora no Balancete (contas S), por tipoBalancete.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#verificaSaldoDe"/>
                <owl:someValuesFrom rdf:resource="#BalanceteVerificacao"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#detectaInconsistencia"/>
                <owl:someValuesFrom rdf:resource="#InconsistenciaEquilibrioDevedorCredor"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#relacionadaCom"/>
                <owl:someValuesFrom rdf:resource="#RegraConsistenciaDebitoMovimentoContabil"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- BV29 -->
    <owl:Class rdf:about="#RegraConsistenciaDebitoMovimentoContabil">
        <rdfs:subClassOf rdf:resource="#RegraContabil"/>
        <rdfs:label xml:lang="pt">Regra BV29 - Consistência do Débito com Movimento Contábil</rdfs:label>
        <rdfs:comment>BV29: movimentoDevedora (contas S) do Balancete = Σ lançamentos D no Movimento Contábil, por conta.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#comparaMovimentoCom"/>
                <owl:someValuesFrom rdf:resource="#BalanceteVerificacao"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#comparaMovimentoCom"/>
                <owl:someValuesFrom rdf:resource="#MovimentoContabil"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#detectaInconsistencia"/>
                <owl:someValuesFrom rdf:resource="#InconsistenciaMovimentoDebito"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#relacionadaCom"/>
                <owl:someValuesFrom rdf:resource="#RegraEquilibrioMovimento"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- BV32 -->
    <owl:Class rdf:about="#RegraExcessoArrecadacao">
        <rdfs:subClassOf rdf:resource="#RegraContabil"/>
        <rdfs:label xml:lang="pt">Regra BV32 - Excesso de Arrecadação</rdfs:label>
        <rdfs:comment>BV32: SaldoAtualDevedor da conta 5.2.2.1.3.02 deve ser menor ou igual à soma dos TiposAlteração 2, 6, 11 e 17.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#verificaConta"/>
                <owl:someValuesFrom rdf:resource="#ContaContabil"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#comparaCom"/>
                <owl:someValuesFrom rdf:resource="#AlteracaoOrcamentaria"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#detectaInconsistencia"/>
                <owl:someValuesFrom rdf:resource="#InconsistenciaExcessoArrecadacao"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>


    <!-- == Família Execução da Despesa == -->
    <!-- RegraLimiteAcumuladoEmpenho, RegraConsistenciaComBalancete e            -->
    <!-- RegraExistenciaCorrespondente são "padrões estruturais": cada uma tem   -->
    <!-- múltiplos indivíduos, pois o Analisador SICAP aplica a MESMA regra      -->
    <!-- textual a entidades diferentes.                                        -->

    <!-- BV30 (espelha BV29 para o lado credor) -->
    <owl:Class rdf:about="#RegraConsistenciaCreditoMovimentoContabil">
        <rdfs:subClassOf rdf:resource="#RegraContabil"/>
        <rdfs:label xml:lang="pt">Regra BV30 - Consistência do Crédito com Movimento Contábil</rdfs:label>
        <rdfs:comment>BV30: movimentoCredora (contas S) do Balancete = soma dos lançamentos C no Movimento Contábil, por conta. Complementar à BV29.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#comparaMovimentoCom"/>
                <owl:someValuesFrom rdf:resource="#BalanceteVerificacao"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#comparaMovimentoCom"/>
                <owl:someValuesFrom rdf:resource="#MovimentoContabil"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#detectaInconsistencia"/>
                <owl:someValuesFrom rdf:resource="#InconsistenciaMovimentoCredito"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- LIQ3 e PG3 -->
    <owl:Class rdf:about="#RegraLimiteAcumuladoEmpenho">
        <rdfs:subClassOf rdf:resource="#RegraContabil"/>
        <rdfs:label xml:lang="pt">Regra de Limite pelo Acumulado do Empenho (LIQ3, PG3)</rdfs:label>
        <rdfs:comment>Padrão estrutural: o valor acumulado de uma entidade (Liquidação ou Pagamento) não pode superar o valor acumulado do Empenho equivalente.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#naoPodeSuperarAcumuladoDe"/>
                <owl:someValuesFrom rdf:resource="#Empenho"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#detectaInconsistencia"/>
                <owl:someValuesFrom rdf:resource="#InconsistenciaLimiteAcumuladoEmpenho"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- LIQ4, PG4 e EMP8 -->
    <owl:Class rdf:about="#RegraConsistenciaComBalancete">
        <rdfs:subClassOf rdf:resource="#RegraContabil"/>
        <rdfs:label xml:lang="pt">Regra de Consistência com o Balancete de Despesa (LIQ4, PG4, EMP8)</rdfs:label>
        <rdfs:comment>Padrão estrutural: o total do arquivo (Liquidação, Pagamento ou Empenho) deve ser exatamente igual ao total informado no BalanceteDespesa.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#deveIgualarTotalDe"/>
                <owl:someValuesFrom rdf:resource="#BalanceteDespesa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#detectaInconsistencia"/>
                <owl:someValuesFrom rdf:resource="#InconsistenciaTotalDivergenteBalancete"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- CLQ4 e CD9 -->
    <owl:Class rdf:about="#RegraExistenciaCorrespondente">
        <rdfs:subClassOf rdf:resource="#RegraContabil"/>
        <rdfs:label xml:lang="pt">Regra de Existência Correspondente (CLQ4, CD9)</rdfs:label>
        <rdfs:comment>Padrão estrutural: um registro de um arquivo deve ter correspondência obrigatória em outro arquivo (CLQ4: Liquidação-Comprovante; CD9: contas de caixa do Balancete-ContaDisponibilidade). Os alvos diferem por indivíduo, por isso a restrição de destino fica a nível de indivíduo, não de classe.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#detectaInconsistencia"/>
                <owl:someValuesFrom rdf:resource="#InconsistenciaExistenciaCorrespondente"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- PGF3 -->
    <owl:Class rdf:about="#RegraConsistenciaFonteRecurso">
        <rdfs:subClassOf rdf:resource="#RegraContabil"/>
        <rdfs:label xml:lang="pt">Regra PGF3 - Consistência da Fonte de Recurso</rdfs:label>
        <rdfs:comment>PGF3: a Fonte informada no PagamentoFinanceiro deve coincidir com a Fonte informada no Empenho equivalente.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#deveCoincidirFonteCom"/>
                <owl:someValuesFrom rdf:resource="#Empenho"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#detectaInconsistencia"/>
                <owl:someValuesFrom rdf:resource="#InconsistenciaFonteDivergente"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>


    <!-- == Família Disponibilidade Financeira == -->

    <!-- CD7 e CD8 -->
    <owl:Class rdf:about="#RegraSaldoDerivadoBalancete">
        <rdfs:subClassOf rdf:resource="#RegraContabil"/>
        <rdfs:label xml:lang="pt">Regra de Saldo Derivado do Balancete (CD7, CD8)</rdfs:label>
        <rdfs:comment>Padrão estrutural: o saldo (inicial ou final) da ContaDisponibilidade deve ser igual ao saldo líquido (devedor-credor) equivalente no Balancete de Verificação.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#derivaSaldoDe"/>
                <owl:someValuesFrom rdf:resource="#BalanceteVerificacao"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#detectaInconsistencia"/>
                <owl:someValuesFrom rdf:resource="#InconsistenciaSaldoDerivadoBalancete"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>


    <!-- == Família Receita/Orçamento == -->

    <!-- LOR5 e BR7 -->
    <owl:Class rdf:about="#RegraAgregacaoHierarquica">
        <rdfs:subClassOf rdf:resource="#RegraContabil"/>
        <rdfs:label xml:lang="pt">Regra de Agregação Hierárquica (LOR5, BR7)</rdfs:label>
        <rdfs:comment>Padrão estrutural (novo tipo de raciocínio): o valor de uma conta sintética deve corresponder ao somatório de suas contas filhas analíticas. LOR5 opera sobre a LOA Receita (planejamento); BR7, sobre o Balancete de Receita (execução).</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#agregaValoresDe"/>
                <owl:someValuesFrom rdf:resource="#ContaReceitaOrcamentaria"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#detectaInconsistencia"/>
                <owl:someValuesFrom rdf:resource="#InconsistenciaHierarquiaContas"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- BR10 -->
    <owl:Class rdf:about="#RegraProporcaoPercentual">
        <rdfs:subClassOf rdf:resource="#RegraContabil"/>
        <rdfs:label xml:lang="pt">Regra BR10 - Proporção Percentual</rdfs:label>
        <rdfs:comment>BR10 (novo tipo de raciocínio): a dedução da receita para formação do FUNDEB deve ser 20% da Receita Realizada Acumulada correspondente.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#deveCorresponderPercentualDe"/>
                <owl:someValuesFrom rdf:resource="#BalanceteReceita"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#detectaInconsistencia"/>
                <owl:someValuesFrom rdf:resource="#InconsistenciaProporcaoPercentual"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- BV37 -->
    <owl:Class rdf:about="#RegraTransferenciaEntreExercicios">
        <rdfs:subClassOf rdf:resource="#RegraContabil"/>
        <rdfs:label xml:lang="pt">Regra BV37 - Transferência Entre Exercícios</rdfs:label>
        <rdfs:comment>BV37 (novo tipo de raciocínio): o saldo de Superávit/Déficit do Exercício deve ser transferido para Superávit/Déficit de Exercícios Anteriores, zerando na 1ª remessa do exercício seguinte.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#verificaConta"/>
                <owl:someValuesFrom rdf:resource="#ContaContabil"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#detectaInconsistencia"/>
                <owl:someValuesFrom rdf:resource="#InconsistenciaTransferenciaExercicio"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- BD6 e BD22 -->
    <owl:Class rdf:about="#RegraConsistenciaAlteracaoOrcamentariaDespesa">
        <rdfs:subClassOf rdf:resource="#RegraContabil"/>
        <rdfs:label xml:lang="pt">Regra de Consistência com Alteração Orçamentária da Despesa (BD6, BD22)</rdfs:label>
        <rdfs:comment>Padrão estrutural (reaproveita a lógica da BV32, agora do lado da despesa): valores do BalanceteDespesa devem corresponder à soma de tipos específicos de AlteracaoOrcamentaria.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#comparaCom"/>
                <owl:someValuesFrom rdf:resource="#AlteracaoOrcamentaria"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#detectaInconsistencia"/>
                <owl:someValuesFrom rdf:resource="#InconsistenciaAlteracaoOrcamentariaDespesa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <!-- BV43 -->
    <owl:Class rdf:about="#RegraCoberturaDDR">
        <rdfs:subClassOf rdf:resource="#RegraContabil"/>
        <rdfs:label xml:lang="pt">Regra BV43 - Cobertura por Disponibilidade De Recursos</rdfs:label>
        <rdfs:comment>BV43 (novo tipo de raciocínio - cadeia de execução): o somatório das contas DDR comprometidas deve ser maior ou igual ao somatório dos Empenhos na fonte específica.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#deveSerCobertoPor"/>
                <owl:someValuesFrom rdf:resource="#Empenho"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#detectaInconsistencia"/>
                <owl:someValuesFrom rdf:resource="#InconsistenciaCoberturaDDR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>


    <!-- == Família Comprovação Documental == -->

    <!-- CLQ2 -->
    <owl:Class rdf:about="#RegraDeteccaoDuplicidade">
        <rdfs:subClassOf rdf:resource="#RegraContabil"/>
        <rdfs:label xml:lang="pt">Regra CLQ2 - Detecção de Duplicidade</rdfs:label>
        <rdfs:comment>CLQ2 (novo tipo de raciocínio - unicidade/anomalia): não é possível ter nota fiscal do mesmo credor, com o mesmo número, e com datas diferentes.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#detectaDuplicidadeEm"/>
                <owl:someValuesFrom rdf:resource="#ComprovanteLiquidacao"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#detectaInconsistencia"/>
                <owl:someValuesFrom rdf:resource="#InconsistenciaDuplicidadeDocumento"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>


    <!-- =================================================================== -->
    <!-- SUBCLASSES DE Inconsistencia                                         -->
    <!-- =================================================================== -->

    <owl:Class rdf:about="#InconsistenciaEquilibrioDevedorCredor">
        <rdfs:subClassOf rdf:resource="#Inconsistencia"/>
        <rdfs:label xml:lang="pt">Inconsistência de Equilíbrio Devedor-Credor</rdfs:label>
        <rdfs:comment>BV3: somatório devedores difere dos credores no Balancete.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#implicaViolacaoDe"/>
                <owl:someValuesFrom rdf:resource="#RegraEquilibrioMovimento"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#InconsistenciaMovimentoDebito">
        <rdfs:subClassOf rdf:resource="#Inconsistencia"/>
        <rdfs:label xml:lang="pt">Inconsistência de Movimento a Débito</rdfs:label>
        <rdfs:comment>BV29: divergência no movimentoDevedora. Pode propagar violação da BV3.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#implicaViolacaoDe"/>
                <owl:someValuesFrom rdf:resource="#RegraConsistenciaDebitoMovimentoContabil"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#implicaViolacaoDe"/>
                <owl:someValuesFrom rdf:resource="#RegraEquilibrioMovimento"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#InconsistenciaExcessoArrecadacao">
        <rdfs:subClassOf rdf:resource="#Inconsistencia"/>
        <rdfs:label xml:lang="pt">Inconsistência de Excesso de Arrecadação</rdfs:label>
        <rdfs:comment>BV32: saldo da conta 5.2.2.1.3.02 supera o permitido pelas alterações orçamentárias.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#implicaViolacaoDe"/>
                <owl:someValuesFrom rdf:resource="#RegraExcessoArrecadacao"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#InconsistenciaMovimentoCredito">
        <rdfs:subClassOf rdf:resource="#Inconsistencia"/>
        <rdfs:label xml:lang="pt">Inconsistência de Movimento a Crédito</rdfs:label>
        <rdfs:comment>BV30: divergência no movimentoCredora. Complementar à InconsistenciaMovimentoDebito.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#implicaViolacaoDe"/>
                <owl:someValuesFrom rdf:resource="#RegraConsistenciaCreditoMovimentoContabil"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#InconsistenciaLimiteAcumuladoEmpenho">
        <rdfs:subClassOf rdf:resource="#Inconsistencia"/>
        <rdfs:label xml:lang="pt">Inconsistência de Limite pelo Acumulado do Empenho</rdfs:label>
        <rdfs:comment>LIQ3/PG3: valor acumulado da Liquidação ou do Pagamento supera o valor acumulado do Empenho equivalente.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#implicaViolacaoDe"/>
                <owl:someValuesFrom rdf:resource="#RegraLimiteAcumuladoEmpenho"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#InconsistenciaTotalDivergenteBalancete">
        <rdfs:subClassOf rdf:resource="#Inconsistencia"/>
        <rdfs:label xml:lang="pt">Inconsistência de Total Divergente do Balancete</rdfs:label>
        <rdfs:comment>LIQ4/PG4/EMP8: o total do arquivo diverge do total no BalanceteDespesa.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#implicaViolacaoDe"/>
                <owl:someValuesFrom rdf:resource="#RegraConsistenciaComBalancete"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#InconsistenciaExistenciaCorrespondente">
        <rdfs:subClassOf rdf:resource="#Inconsistencia"/>
        <rdfs:label xml:lang="pt">Inconsistência de Existência Correspondente</rdfs:label>
        <rdfs:comment>CLQ4/CD9: registro de um arquivo não possui correspondência obrigatória em outro arquivo.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#implicaViolacaoDe"/>
                <owl:someValuesFrom rdf:resource="#RegraExistenciaCorrespondente"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#InconsistenciaFonteDivergente">
        <rdfs:subClassOf rdf:resource="#Inconsistencia"/>
        <rdfs:label xml:lang="pt">Inconsistência de Fonte Divergente</rdfs:label>
        <rdfs:comment>PGF3: Fonte do PagamentoFinanceiro não coincide com a Fonte do Empenho equivalente.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#implicaViolacaoDe"/>
                <owl:someValuesFrom rdf:resource="#RegraConsistenciaFonteRecurso"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#InconsistenciaSaldoDerivadoBalancete">
        <rdfs:subClassOf rdf:resource="#Inconsistencia"/>
        <rdfs:label xml:lang="pt">Inconsistência de Saldo Derivado do Balancete</rdfs:label>
        <rdfs:comment>CD7/CD8: saldo da ContaDisponibilidade diverge do saldo líquido equivalente no Balancete de Verificação.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#implicaViolacaoDe"/>
                <owl:someValuesFrom rdf:resource="#RegraSaldoDerivadoBalancete"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#InconsistenciaHierarquiaContas">
        <rdfs:subClassOf rdf:resource="#Inconsistencia"/>
        <rdfs:label xml:lang="pt">Inconsistência de Hierarquia de Contas</rdfs:label>
        <rdfs:comment>LOR5/BR7: valor da conta sintética diverge do somatório de suas contas filhas.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#implicaViolacaoDe"/>
                <owl:someValuesFrom rdf:resource="#RegraAgregacaoHierarquica"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#InconsistenciaProporcaoPercentual">
        <rdfs:subClassOf rdf:resource="#Inconsistencia"/>
        <rdfs:label xml:lang="pt">Inconsistência de Proporção Percentual</rdfs:label>
        <rdfs:comment>BR10: dedução do FUNDEB diverge do percentual de 20% esperado.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#implicaViolacaoDe"/>
                <owl:someValuesFrom rdf:resource="#RegraProporcaoPercentual"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#InconsistenciaTransferenciaExercicio">
        <rdfs:subClassOf rdf:resource="#Inconsistencia"/>
        <rdfs:label xml:lang="pt">Inconsistência de Transferência Entre Exercícios</rdfs:label>
        <rdfs:comment>BV37: saldo de Superávit/Déficit do Exercício não foi zerado/transferido na 1ª remessa do exercício seguinte.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#implicaViolacaoDe"/>
                <owl:someValuesFrom rdf:resource="#RegraTransferenciaEntreExercicios"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#InconsistenciaAlteracaoOrcamentariaDespesa">
        <rdfs:subClassOf rdf:resource="#Inconsistencia"/>
        <rdfs:label xml:lang="pt">Inconsistência de Alteração Orçamentária da Despesa</rdfs:label>
        <rdfs:comment>BD6/BD22: valor do BalanceteDespesa diverge da soma dos tipos de AlteracaoOrcamentaria correspondentes.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#implicaViolacaoDe"/>
                <owl:someValuesFrom rdf:resource="#RegraConsistenciaAlteracaoOrcamentariaDespesa"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#InconsistenciaCoberturaDDR">
        <rdfs:subClassOf rdf:resource="#Inconsistencia"/>
        <rdfs:label xml:lang="pt">Inconsistência de Cobertura por DDR</rdfs:label>
        <rdfs:comment>BV43: somatório das contas DDR comprometidas é menor que o somatório dos Empenhos na fonte específica.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#implicaViolacaoDe"/>
                <owl:someValuesFrom rdf:resource="#RegraCoberturaDDR"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>

    <owl:Class rdf:about="#InconsistenciaDuplicidadeDocumento">
        <rdfs:subClassOf rdf:resource="#Inconsistencia"/>
        <rdfs:label xml:lang="pt">Inconsistência de Duplicidade de Documento</rdfs:label>
        <rdfs:comment>CLQ2: nota fiscal do mesmo credor, com mesmo número, encontrada com datas diferentes.</rdfs:comment>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="#implicaViolacaoDe"/>
                <owl:someValuesFrom rdf:resource="#RegraDeteccaoDuplicidade"/>
            </owl:Restriction>
        </rdfs:subClassOf>
    </owl:Class>


    <!-- =================================================================== -->
    <!-- DISJUNÇÕES                                                           -->
    <!-- =================================================================== -->

    <owl:AllDisjointClasses>
        <owl:members rdf:parseType="Collection">
            <rdf:Description rdf:about="#RegraEquilibrioMovimento"/>
            <rdf:Description rdf:about="#RegraConsistenciaDebitoMovimentoContabil"/>
            <rdf:Description rdf:about="#RegraConsistenciaCreditoMovimentoContabil"/>
            <rdf:Description rdf:about="#RegraExcessoArrecadacao"/>
            <rdf:Description rdf:about="#RegraLimiteAcumuladoEmpenho"/>
            <rdf:Description rdf:about="#RegraConsistenciaComBalancete"/>
            <rdf:Description rdf:about="#RegraExistenciaCorrespondente"/>
            <rdf:Description rdf:about="#RegraConsistenciaFonteRecurso"/>
            <rdf:Description rdf:about="#RegraSaldoDerivadoBalancete"/>
            <rdf:Description rdf:about="#RegraAgregacaoHierarquica"/>
            <rdf:Description rdf:about="#RegraProporcaoPercentual"/>
            <rdf:Description rdf:about="#RegraTransferenciaEntreExercicios"/>
            <rdf:Description rdf:about="#RegraConsistenciaAlteracaoOrcamentariaDespesa"/>
            <rdf:Description rdf:about="#RegraCoberturaDDR"/>
            <rdf:Description rdf:about="#RegraDeteccaoDuplicidade"/>
        </owl:members>
    </owl:AllDisjointClasses>

